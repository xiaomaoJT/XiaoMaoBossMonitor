{
  "name": "monitor-wall",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "视频监控多路实时预览大屏（Vue 3 + Vite + Jessibuca，支持 H.265 ws-flv；可打包为 macOS 桌面端 / iOS App / 微信小程序）",
  "author": "Mao",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "build:all": "node scripts/build-all.mjs",
    "serve": "node scripts/serve-static.mjs --open",
    "serve:drop": "node server/headless-monitor.mjs --drop-pending",
    "pack:portable": "npm run build && node scripts/make-portable.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --mac",
    "electron:build:dir": "npm run build && electron-builder --mac --dir",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:win:dir": "npm run build && electron-builder --win --dir",
    "electron:smoke": "npm run build && MONITOR_SMOKE_TEST=1 electron .",
    "cap:sync": "npm run build && cap sync",
    "ios:add": "npm run build && cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run build && cap run ios",
    "ios:copy": "npm run build && cap copy ios",
    "watch:build": "node scripts/build-watch.mjs",
    "watch:register": "node scripts/build-watch.mjs --register-watch",
    "mp:build": "node scripts/build-mp.mjs",
    "mp:set-url": "node scripts/build-mp.mjs --url=",
    "server": "node server/headless-monitor.mjs",
    "server:status": "curl -s http://127.0.0.1:8787/api/status",
    "win:deploy": "node scripts/make-win-deploy.mjs",
    "win:deploy:zip": "node scripts/make-win-deploy.mjs --zip",
    "ffmpeg:fetch": "node server/ffmpeg-fetch-cli.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "ffmpeg-static": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.30.0",
    "vue": "^3.5.13",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.7"
  }
}
